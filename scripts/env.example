# GCP project and VM mapping
export GCP_PROJECT="your-gcp-project-id"

# Selector VM + zone (Oregon default)
export SELECTOR_VM="dash-selector"
export SELECTOR_ZONE="us-west1-b"

# Iowa selector alternative (us-central1 for lower cross-region latency)
# export SELECTOR_VM="dash-selector-iowa"
# export SELECTOR_ZONE="us-central1-a"

# Origin VM mapping format:
# <server_id>:<vm-name>:<zone>,...
# server_id must be one of: oregon, toronto, ncalifornia
export ORIGIN_VMS="oregon:dash-origin-oregon:us-west1-b,toronto:dash-origin-toronto:northamerica-northeast2-a,ncalifornia:dash-origin-ncalifornia:us-west2-b"

# Selector-to-origin endpoint mapping format:
# <server_id>:<base_url>,...
export ORIGIN_ENDPOINTS="oregon:http://10.0.0.10,toronto:http://10.0.1.10,ncalifornia:http://10.0.2.10"

# Public URL used by tests/client
export SELECTOR_BASE_URL="http://X.X.X.X"

# Optional selector tuning
export SELECTOR_MODE="adaptive"
export SELECTOR_WEIGHT_LATENCY="0.65"
export SELECTOR_WEIGHT_LOAD="0.25"
export SELECTOR_WEIGHT_THROUGHPUT="0.10"

# Optional: override the manifest path that the selector serves and fetches from origins.
# Example: export SELECTOR_MANIFEST_PATH="/video/dash_content/clip1/manifest.mpd"

# Optional: override the media file path used for selector probing/tests.
# Example: export SELECTOR_SEGMENT_PATH="/video/dash_content/clip1/360p_dashinit.mp4"
